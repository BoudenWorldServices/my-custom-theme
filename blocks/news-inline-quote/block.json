{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "goliath/news-inline-quote",
  "title": "News – Inline Quote",
  "description": "A full-width pull quote with a large orange opening quotation mark. Use to highlight a key quote from press coverage.",
  "category": "goliath",
  "icon": "format-quote",
  "keywords": [
    "news",
    "quote",
    "pull quote",
    "press"
  ],
  "textdomain": "my-custom-theme",
  "render": "file:./render.php",
  "attributes": {
    "quote": {
      "type": "string",
      "default": ""
    },
    "attribution": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": false
  }
}
